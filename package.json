{
  "name": "tamannashut-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tamanna's Hut ecommerce storefront and marketplace operations platform",
  "scripts": {
    "server": "nodemon --exec node --import ./server/src/instrument.js server/src/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node --import ./server/src/instrument.js server/src/server.js",
    "test:unit": "node --test tests/*.test.js",
    "pretest:e2e": "npm run build --prefix client",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": ["ecommerce", "marketplace", "kids-fashion"],
  "author": "Tamanna's Hut",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "razorpay": "^2.9.6",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "resend": "^6.12.4",
    "streamifier": "^0.1.1",
    "swiper": "^14.1.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
