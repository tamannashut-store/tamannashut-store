# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/tamannashut
JWT_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=owner@example.com

# Storefront (embedded at build time)
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Tamanna's Hut <orders@example.com>

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_SECRET=

# Seller marketplace
SELLER_DATA_ENCRYPTION_KEY=
MARKETPLACE_COMMISSION_PERCENT=0
MARKETPLACE_SETTLEMENT_HOLD_DAYS=7

# Twilio Verify (optional; required for phone verification)
TWILIO_SID=
TWILIO_AUTH=
TWILIO_VERIFY_SERVICE_SID=

# Instagram feed (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v23.0

# Sentry backend (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
# Render supplies this automatically in production.
RENDER_GIT_COMMIT=

# Sentry storefront (optional; embedded at build time)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_APP_RELEASE=
